<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#FFFFE98A"
                        android:centerColor="#FFFFD700"
                        android:endColor="#FFB8860B" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="52dp" android:left="18dp" android:right="18dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#80FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
