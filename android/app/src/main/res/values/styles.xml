<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Hero" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_numeric</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.CtaFrame.Primary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_primary_height</item>
        <item name="android:background">@drawable/btn_primary_chrome</item>
        <item name="android:elevation">@dimen/card_elevation</item>
    </style>

    <style name="Widget.App.CtaFrame.Gold" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_mission_height</item>
        <item name="android:background">@drawable/btn_gold_chrome</item>
        <item name="android:elevation">@dimen/card_elevation</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">@dimen/radius_l</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="iconSize">@dimen/btn_icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/gap_s</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Gold" parent="Widget.App.Button.Primary">
        <item name="android:textColor">@color/midnight_navy</item>
        <item name="iconTint">@color/midnight_navy</item>
        <item name="rippleColor">@color/stroke_white_soft</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_secondary_height</item>
        <item name="android:minHeight">@dimen/btn_secondary_height</item>
        <item name="backgroundTint">@color/fill_white_soft</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="strokeColor">@color/stroke_cyan_soft</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="iconSize">@dimen/btn_icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/gap_xs</item>
        <item name="iconTint">@color/cyber_cyan</item>
    </style>

    <style name="Widget.App.Button.Dialog" parent="Widget.App.Button.Secondary">
        <item name="android:layout_height">@dimen/btn_dialog_height</item>
        <item name="android:minHeight">@dimen/btn_dialog_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/radius_m</item>
    </style>

    <style name="Widget.App.Button.Nav" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Button.Tab" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_tab_height</item>
        <item name="android:minHeight">@dimen/btn_tab_height</item>
        <item name="backgroundTint">@color/fill_white_soft</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="strokeColor">@color/stroke_white_soft</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Card.Surface" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="strokeColor">@color/stroke_white_soft</item>
    </style>

    <style name="Widget.App.Card.Sheet" parent="Widget.App.Card.Surface">
        <item name="cardBackgroundColor">@color/surface_sheet</item>
        <item name="cardElevation">@dimen/sheet_elevation</item>
        <item name="strokeColor">@color/stroke_light</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Sheet</item>
    </style>

    <style name="ShapeAppearance.App.Sheet" parent="">
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
