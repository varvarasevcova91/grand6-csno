<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_map">

    <ImageView
        android:id="@+id/map_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/map_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_map_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/map_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_xs"
        android:paddingTop="@dimen/status_inset"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_back"
            style="@style/Widget.App.Button.Nav"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:text="@string/cta_menu" />

        <TextView
            android:id="@+id/map_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/map_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textColor="@color/text_primary" />

        <com.featherroad.quest.core.ui.BalanceChipView
            android:id="@+id/map_balance"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chip_height" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/map_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/gap_m"
        app:layout_constraintBottom_toTopOf="@id/map_start_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_header" />

    <FrameLayout
        android:id="@+id/map_start_frame"
        style="@style/Widget.App.CtaFrame.Gold"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/control_bar_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_start"
            style="@style/Widget.App.Button.Gold"
            android:text="@string/cta_start_mission"
            app:icon="@drawable/ic_speed" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
