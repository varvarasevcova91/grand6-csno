<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/gap_s">

    <LinearLayout
        android:id="@+id/settings_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_l">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:letterSpacing="0.16"
            android:text="@string/dialog_settings_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/gap_m"
            android:background="@color/stroke_white_soft"
            android:importantForAccessibility="no" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_sound"
            style="@style/Widget.App.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:text="@string/setting_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_music"
            style="@style/Widget.App.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_music" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_vibration"
            style="@style/Widget.App.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_vibration" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:letterSpacing="0.2"
            android:text="@string/setting_quality"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_micro" />

        <LinearLayout
            android:id="@+id/settings_quality_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_quality_low"
                style="@style/Widget.App.Button.Tab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/quality_low" />

            <Space
                android:layout_width="@dimen/gap_xs"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_quality_med"
                style="@style/Widget.App.Button.Tab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/quality_med" />

            <Space
                android:layout_width="@dimen/gap_xs"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_quality_high"
                style="@style/Widget.App.Button.Tab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/quality_high" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_reset"
            style="@style/Widget.App.Button.Dialog"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/cta_reset"
            android:textColor="@color/sunset_orange"
            app:strokeColor="@color/sunset_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_close"
            style="@style/Widget.App.Button.Dialog"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/gap_s"
            android:text="@string/cta_close" />

    </LinearLayout>

</RelativeLayout>
