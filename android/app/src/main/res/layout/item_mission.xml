<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/gap_s">

    <LinearLayout
        android:id="@+id/mission_root"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mission_row_height"
        android:background="@drawable/card_neon_stroke"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_m"
        android:paddingEnd="@dimen/gap_m">

        <ImageView
            android:id="@+id/mission_thumb"
            android:layout_width="@dimen/mission_thumb"
            android:layout_height="@dimen/mission_thumb"
            android:contentDescription="@string/cd_district"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_city_neon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mission_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/mission_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <LinearLayout
                android:id="@+id/mission_pips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mission_pip_1"
                    android:layout_width="@dimen/pip_size"
                    android:layout_height="@dimen/pip_size"
                    android:background="@drawable/bg_pip_off" />

                <View
                    android:id="@+id/mission_pip_2"
                    android:layout_width="@dimen/pip_size"
                    android:layout_height="@dimen/pip_size"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:background="@drawable/bg_pip_off" />

                <View
                    android:id="@+id/mission_pip_3"
                    android:layout_width="@dimen/pip_size"
                    android:layout_height="@dimen/pip_size"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:background="@drawable/bg_pip_off" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/mission_locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_cyan_bg"
            android:letterSpacing="0.16"
            android:paddingStart="@dimen/gap_s"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/gap_s"
            android:paddingBottom="4dp"
            android:text="@string/mission_locked"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
