<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_night">

    <ImageView
        android:id="@+id/menu_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/menu_fade_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.34" />

    <View
        android:id="@+id/menu_fade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_menu_fade"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/menu_fade_guide" />

    <ImageView
        android:id="@+id/menu_palm"
        android:layout_width="@dimen/menu_palm_width"
        android:layout_height="@dimen/menu_palm_height"
        android:alpha="0.85"
        android:contentDescription="@string/cd_palm"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_palm_neon"
        app:layout_constraintBottom_toTopOf="@id/menu_sheet"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/gap_s"
        android:layout_marginBottom="@dimen/gap_l" />

    <ImageView
        android:id="@+id/menu_hero_car"
        android:layout_width="@dimen/menu_car_width"
        android:layout_height="@dimen/menu_car_height"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/gap_xl"
        android:contentDescription="@string/cd_hero_car"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_car_hero"
        app:layout_constraintBottom_toTopOf="@id/menu_sheet"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/menu_status_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/status_inset"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/menu_rank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.18"
            android:text="@string/menu_rank"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/cyber_cyan"
            android:textSize="@dimen/text_caption" />

        <com.featherroad.quest.core.ui.BalanceChipView
            android:id="@+id/menu_balance"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chip_height" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menu_sheet"
        style="@style/Widget.App.Card.Sheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_wide"
            android:paddingTop="@dimen/gap_l"
            android:paddingEnd="@dimen/screen_margin_wide"
            android:paddingBottom="@dimen/gap_xl">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:shadowColor="@color/neon_pink"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:text="@string/menu_title"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_menu_title" />

            <LinearLayout
                android:id="@+id/menu_stat_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <com.featherroad.quest.core.ui.StatCardView
                    android:id="@+id/menu_stat_best"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:statAccent="@color/cyber_cyan"
                    app:statLabel="@string/stat_best_run" />

                <Space
                    android:layout_width="@dimen/gap_s"
                    android:layout_height="1dp" />

                <com.featherroad.quest.core.ui.StatCardView
                    android:id="@+id/menu_stat_missions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:statAccent="@color/luxury_gold"
                    app:statLabel="@string/stat_missions" />

            </LinearLayout>

            <TextView
                android:id="@+id/menu_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/gap_m"
                android:layout_marginBottom="@dimen/gap_m"
                android:letterSpacing="0.12"
                android:text="@string/menu_hint"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <FrameLayout
                android:id="@+id/menu_play_frame"
                style="@style/Widget.App.CtaFrame.Primary">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_play"
                    style="@style/Widget.App.Button.Primary"
                    android:text="@string/cta_play"
                    app:icon="@drawable/ic_speed" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/menu_secondary_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_city_map"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/cta_city_map" />

                <Space
                    android:layout_width="@dimen/gap_s"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_garage"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/cta_garage" />

                <Space
                    android:layout_width="@dimen/gap_s"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_settings"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/cta_settings" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
