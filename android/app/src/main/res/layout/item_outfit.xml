<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/gap_xs">

    <LinearLayout
        android:id="@+id/outfit_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_neon_stroke"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/gap_m">

        <ImageView
            android:id="@+id/outfit_thumb"
            android:layout_width="@dimen/outfit_thumb"
            android:layout_height="@dimen/outfit_thumb"
            android:contentDescription="@string/cd_outfit_preview"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_outfit_vip" />

        <TextView
            android:id="@+id/outfit_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/outfit_owned_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

            <TextView
                android:id="@+id/outfit_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/luxury_gold"
                android:textSize="@dimen/text_label" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
